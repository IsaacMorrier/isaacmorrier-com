{
  "private": true,
  "name": "isaacmorrier-com",
  "version": "2.0.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "studio",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n studio,web -c blue,magenta \"npm run dev-studio\" \"npm run dev-web\"",
    "dev-studio": "npm run dev --workspace studio",
    "dev-web": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present",
    "build-studio": "npm run build --workspace studio",
    "build-web": "npm run build --workspace web",
    "lint": "npm run lint --workspace studio",
    "format": "npm run format --workspace studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true
  }
}
